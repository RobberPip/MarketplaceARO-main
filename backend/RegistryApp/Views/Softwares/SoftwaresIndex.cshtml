    @* Configure parameters for infinite scrolling htmx request *@
    <script >
        window.addEventListener('htmx:configRequest', (e) => {
            //console.log(e.detail);
            //console.log(e.detail.elt["className"]);
            if (e.detail.elt["className"] === "softwares-content-wrapper") {
                let isInit = sessionStorage.getItem("is_init");
                if (isInit === "1") {
                    let page = parseInt(sessionStorage.getItem("current_page"));
                    sessionStorage.setItem("current_page", page + 1);

                    const params = {};
                    for (i = 0; i < sessionStorage.length; i++) {
                        const key = sessionStorage.key(i);
                        const value = sessionStorage.getItem(key);
                        params[key] = value;
                    }
                    e.detail.parameters = params;      
                } else {
                    e.preventDefault();
                }
    
            }
        });
    </script>
    @* Custom UI logic before htmx request *@
    <script>
        window.addEventListener('htmx:beforeRequest', (e) => {
            document.getElementById("loading-indicator").style.display = "inline";
            document.getElementById("loading-indicator").style.visibility = "visible";
        });
    </script>
    @* Custom UI logic after htmx request *@
    <script>
        window.addEventListener('htmx:afterRequest', (e) => {
            document.getElementById("loading-indicator").style.display = "none";
            document.getElementById("loading-indicator").style.visibility = "hidden";

            //console.log(e.detail.elt["id"] == "softwares-dynamic-page");
            if (e.detail.elt["id"] == "softwares-dynamic-page") {
                window.scrollTo(0, 0);
            }
        });
    </script>
