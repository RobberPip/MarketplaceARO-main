@section Scripts {
    <script>
        window.addEventListener('load', () => {
            sessionStorage.setItem("sort_type", 0);
            sessionStorage.setItem("current_page", 1);

            intializeFiltersStage();
            sessionStorage.setItem("is_init", 1);
        })
    </script>
    @* Intialize session storage properties for keeping stage of page *@
    <script>
        function intializeFiltersStage() {
            let company_filter_data = @Html.Raw(Json.Serialize(ViewData["VendorNames_Selected"]));
            if (company_filter_data != null) {
                sessionStorage.setItem("company_filter", company_filter_data.join(';'));
            } else {
                sessionStorage.setItem("company_filter", "");
            }

            let activity_filter_data = @Html.Raw(Json.Serialize(ViewData["ClassificationActivity_Selected"]));
            if (activity_filter_data != null) {
                sessionStorage.setItem("activity_filter", activity_filter_data.join(';'));
            } else {
                sessionStorage.setItem("activity_filter", "");
            }

            let softwaretype_fiter_data = @Html.Raw(Json.Serialize(ViewData["ClassificationSoftwareType_Selected"]));
            if (softwaretype_fiter_data != null) {
                sessionStorage.setItem("softwareType_filter", softwaretype_fiter_data.join(';'));
            } else {
                sessionStorage.setItem("softwareType_filter", "");
            }

            let mainproduct_fiter_data = @Html.Raw(Json.Serialize(ViewData["MainProduct_Selected"]));
            if (mainproduct_fiter_data != null) {
                sessionStorage.setItem("mainproduct_filter", mainproduct_fiter_data.join(';'));
            } else {
                sessionStorage.setItem("mainproduct_filter", "");
            }

            let stage_fiter_data = @Html.Raw(Json.Serialize(ViewData["ClassificationLifeStage_Selected"]));
            if (stage_fiter_data != null) {
                sessionStorage.setItem("stage_filter", stage_fiter_data.join(';'));
            } else {
                sessionStorage.setItem("stage_filter", "");
            }

            let content_fiter_data = @Html.Raw(Json.Serialize(ViewData["ClassificationContent_Selected"]));
            if (content_fiter_data != null) {
                sessionStorage.setItem("content_filter", content_fiter_data.join(';'));
            } else {
                sessionStorage.setItem("content_filter", "");
            }

            let workwithCIM_filter_data = '@ViewData["WorkWitnCIM_Checked"]';
            if (workwithCIM_filter_data == "1") {
                sessionStorage.setItem("workwithCIM_filter", 1);
            } else {
                sessionStorage.setItem("workwithCIM_filter", 0);
            }

            let isNotimMember_filter_data = '@ViewData["IsNotimMember_Checked"]';
            if (isNotimMember_filter_data == "1") {
                sessionStorage.setItem("isNotimMember_filter", 1);
            } else {
                    sessionStorage.setItem("isNotimMember_filter", 0);
            }

            let regReestr_filter_data = '@ViewData["RegReestr_Checked"]';
            if (regReestr_filter_data == "1") {
                sessionStorage.setItem("regReestr_filter", 1);
            } else {
                sessionStorage.setItem("regReestr_filter", 0);
            }

            let searchRequest = '@ViewData["SearchRequest"]';
            if (searchRequest !== null && searchRequest !== "") {
                sessionStorage.setItem("search_request", searchRequest);
            } else {
                sessionStorage.setItem("search_request", "");
            }
        }
    </script>
    @* Intialize custom scrollbars (perfect-scrollbar.js) *@
    <script>
        var vendorScroll;
        var vendorScrollMobile;
        var contentScroll;
        var contentScrollMobile;
        var mainproductScroll;
        var mainproductScrollMobile;
    </script>
    @* Custom UI logig for collapse filter menu and update custom scrollbars *@
    <script>
        function collapseFilterMenu(el) {
            el.classList.toggle("active");
            var panel = el.nextElementSibling;
            if (panel.style.display == "block") {
                panel.style.display = "none";
            } else {
                panel.style.display = "block";

                vendorScroll = new PerfectScrollbar('#company-overflow-container');
                vendorScrollMobile = new PerfectScrollbar('#company-overflow-container-mobile');
                contentScroll = new PerfectScrollbar('#content-overflow-container');
                contentScrollMobile = new PerfectScrollbar('#content-overflow-container-mobile');
                mainproductScroll = new PerfectScrollbar('#mainproduct-overflow-container');
                mainproductScrollMobile = new PerfectScrollbar('#mainproduct-overflow-container-mobile');

                vendorScroll.update();
                vendorScrollMobile.update();
                contentScroll.update();
                contentScrollMobile.update();
                mainproductScroll.update();
                mainproductScrollMobile.update();
            }
        }
    </script>
    @* Custom UI logic for mark entity as checked for miltiple filters *@
    <script>
        function markAsChecked(el) {
            if (el.checked) {
                el.parentElement.classList.add('checked');
            } else {
                el.parentElement.classList.remove('checked');
            }
        }
    </script>
    @* Custom UI logic for mark entity as checked for single radio filters *@
    <script>
        function markAsCheckedForRadio(el) {
            var checks = document.getElementsByName(el.name);
            //debugger;
            checks.forEach(cb => {
                if (cb === el) {
                    //debugger;
                    if (cb.parentElement.classList.contains('checked')) {
                        cb.parentElement.classList.remove('checked');
                    } else {
                        cb.parentElement.classList.add('checked');
                    }
                } else {
                    cb.checked = false;
                    cb.parentElement.classList.remove('checked');
                }
            });
        }
    </script>
    @* Filter entities by search input and update custom scrollbars *@
    <script> 
        function filterByInput(input, markList) {
            var input, filter, ul, li, a, i, txtValue;
            input = document.getElementById(input);
            filter = input.value.toUpperCase();
            ul = document.getElementById(markList);
            li = ul.getElementsByTagName('li');

            var vendorCnt = document.getElementById('company-overflow-container');
            vendorCnt.scrollTop = 0;
            var vendorCntMobile = document.getElementById('company-overflow-container-mobile');
            vendorCntMobile.scrollTop = 0;

            var contentCnt = document.getElementById('content-overflow-container');
            contentCnt.scrollTop = 0;
            var contentCntMobile = document.getElementById('content-overflow-container-mobile');
            contentCntMobile.scrollTop = 0;

            var mainproductCnt = document.getElementById('mainproduct-overflow-container');
            mainproductCnt.scrollTop = 0;
            var mainproductCntMobile = document.getElementById('mainproduct-overflow-container-mobile');
            mainproductCntMobile.scrollTop = 0;

            for (i = 0; i < li.length; i++) {
                a = li[i].getElementsByTagName("label")[0];
                txtValue = a.textContent || a.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    li[i].style.display = "";

                    vendorScroll.update();
                    vendorScrollMobile.update();
                    contentScroll.update();
                    contentScrollMobile.update();
                    mainproductScroll.update();
                    mainproductScrollMobile.update();
                } else {
                    li[i].style.display = "none";

                    vendorScroll.update();
                    vendorScrollMobile.update();
                    contentScroll.update();
                    contentScrollMobile.update();
                    mainproductScroll.update();
                    mainproductScrollMobile.update();
                }
            }
