    @* Prapare data of filter *@
    <script>
        function getDataFromCheckFilter(element) {
            let filter_checked = [];
            const filter_items = document.getElementById(element);
            //debugger;
            const filter_data = Array.from(filter_items.querySelectorAll("input"))
                .map(({ id, checked }) => ({ id, checked }));

            for (let data of filter_data) {
                if (data["checked"] == true) {
                    filter_checked.push(data["id"]);
                }
            }
            return filter_checked.join(';');
        }
