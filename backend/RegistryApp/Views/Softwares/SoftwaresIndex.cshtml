    @* Handle by filter-chip button: prepare and set parameters for htmx request *@
    <script>
        function cleanSoftwareFilterByChip(el) {
            let filterName = el.getAttribute("data-filter-name");
            let filterValue = el.getAttribute("data-filter-value");
            let isSingleFilter = el.getAttribute("data-single-filter");

            // Handler for mark filter entity checkbox as unchecked
            markFilterEntitiesAsUnchecked(filterValue, filterName);

            if (isSingleFilter == "True") {
                sessionStorage.setItem(filterName, 0);
                sessionStorage.setItem("current_page", 1);
            } else {
                let stage = sessionStorage.getItem(filterName).split(';');
                //console.log(stage);
                let newFilterStage = stage.filter((item) => item !== filterValue);
                //console.log(newFilterStage);
                
                sessionStorage.setItem(filterName, newFilterStage.join(';'));
                sessionStorage.setItem("current_page", 1);
            }

            const params = {};
            for (i = 0; i < sessionStorage.length; i++) {
                const key = sessionStorage.key(i);
                const value = sessionStorage.getItem(key);
                params[key] = value;
            }

            params["oob_update"] = 1;
            el.setAttribute('hx-vals', JSON.stringify(params))
        }
    </script>
    @* Custom UI logic for mark filter entity as unchecked by handle filterChip *@
    <script>
        function markFilterEntitiesAsUnchecked(filterValue, filterName) {
            //debugger;
            var filterEntities = Array.from(document.getElementsByName(filterName))
                .filter(item => item.id === filterValue)
                .forEach(item => {
                    item.parentElement.classList.remove('checked');
                    item.checked = false;   
                });
            //console.log(filterEntities);
        }
