@model SoftwareVM[]
@{
    ViewData["Title"] = "Реестр ПО";
}

<div class="container-fluid">
    <div class="render-body">
        <div class="registry-heading-container">
            <h3>Перечень цифровых продуктов для строительства</h3>
            <div id="inline-cheaps-container" class="inline-cheaps-container">
                @if ((bool)ViewData["HasFilters"])
                {
                    <p class="text1-gray" style="margin-right:32px;">найдено @ViewData["SoftwaresCount"] штук</p>
                    @foreach (var filterChip in ViewData["FilterChips"] as List<FilterChipVM>)
                    {
                        <button type="button" class="filter-chip" data-filter-name="@filterChip.FilterName"
                                data-filter-value="@filterChip.FilterValue" data-single-filter="@filterChip.IsSingleFilter"
                                hx-post="/softwares" hx-vals="" hx-target="#software-collection" onclick="cleanSoftwareFilterByChip(this)">
                            @filterChip.FilterValue
                            <span>
                                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M7.19635 5.99635L12 10.8L10.817 12L6.00012 7.1907L1.18325 12L0.000244141 10.8L4.8039 5.99635L0 1.2L1.2 0L6.00012 4.80012L10.8002 0L12.0002 1.2L7.19635 5.99635Z" fill="#898989" />
                                </svg>
                            </span>
                        </button>
                    }
                    <button type="button" class="filter-chip-cleanall" onclick="cleanAllSoftwareFilters(this)"
                            hx-post="/softwares" hx-vals="" hx-target="#software-collection">
                        Очистить все фильтры
                    </button>
                    <button type="button" class="software-index-share-btn" onclick="getFiltersShortLink()">
