    @* Handle by filter entity in list: prepare parameters for htmx request *@
    <script>
        function filterSoftwaresSubmitByEntityInList(el) {
            var filterName = el.getAttribute("name");
            var filterValue = el.id;
            //debugger;
            
            if (el.checked) {
                var stage = sessionStorage.getItem(filterName);
                if (stage == "") {
                    sessionStorage.setItem(filterName, filterValue);
                } else {
                    stage = stage + ';' + filterValue;
                    sessionStorage.setItem(filterName, stage);
                }
            } else {
                var stage = sessionStorage.getItem(filterName).split(';');
                if (Array.isArray(stage)) {
                    stage = stage.filter((item) => item !== filterValue);
                    sessionStorage.setItem(filterName, stage.join(';'));
                } else {
                    sessionStorage.setItem(filterName, "");
                }
            }

            sessionStorage.setItem("current_page", 1);
            const params = {};
            for (i = 0; i < sessionStorage.length; i++) {
                const key = sessionStorage.key(i);
                const value = sessionStorage.getItem(key);
                params[key] = value;
            }

            params["oob_update"] = 1;
            el.setAttribute('hx-vals', JSON.stringify(params))
        }
    </script>
