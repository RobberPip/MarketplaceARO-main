    @* Send request for share short link and await responce *@
    <script>
        async function getFiltersShortLink() {
            var stageParams = new URLSearchParams();
            for (i = 0; i < sessionStorage.length; i++) {
                var key = sessionStorage.key(i);
                var value = sessionStorage.getItem(key);
                stageParams.set(key, value);
            }
            const res = await fetch('/shortlink/getfiltersshortlink', {
                method: 'POST',
                body: stageParams
            })

            if (!res.ok) {
                showNotification('Произошла ошибка. Попробуйте позже');
                return;
            }

            const link = await res.text();

            const blob = new Blob([link], { type: "text/plain" });
            const clipboardText = new ClipboardItem({ 'text/plain': blob });
            setTimeout(() => {
                navigator.clipboard.write([clipboardText]);
                showNotification('Ссылка скопирована в буфер обмена');
            }, 0);
        }
    </script>
