                        </div>
                    </button>
                </div>
            }
        }
        <script>
            function toggleLike(event, softwareId, element) {
                event.stopPropagation();
                if (!@Json.Serialize(ViewBag.IsAuthenticated)) {
                    return;
                }

                let isLiked = element.getAttribute("fill") === "currentColor";
                let newFill = isLiked ? "none" : "currentColor";
                let newStroke = isLiked ? "#000000" : "none";

                element.setAttribute("fill", newFill);
                let path = element.querySelector("path");
                if (path) {
                    path.setAttribute("stroke", newStroke);
                }

                sendLikeRequest(softwareId, !isLiked, element);
            }

            function sendLikeRequest(softwareId, like, element) {
                fetch('/api/v1/like-software', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        "softwareId": softwareId,
                        "like": like
                    })
                })
                    .then(response => response.json())
                    .then(data => {
                        updateLikeCount(softwareId, data.likeCount);
                    })
            }

            function updateLikeCount(softwareId, likeCount) {
                let likeText = document.querySelector(`#like-count-${softwareId}`);
                let separator = document.querySelector(`#like-separator-${softwareId}`);
                let vendorName = document.querySelector(`#vendor-name-${softwareId}`);

                if (likeText) {
                    likeText.textContent = `${likeCount}`;
                }


                if (vendorName && vendorName.textContent.trim() !== "") {
                    separator.style.display = 'inline'; 
                }
            }

        </script>
