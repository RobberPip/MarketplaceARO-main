                    <button class="filter-search-close-btn" onclick="cleanFilterSearchInput('mainproduct-filter-input-mobile', 'mainproduct-filter-marklist-mobile')">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <g id="Icons">
                                <g id="Vector">
                                    <path d="M20 10C20 4.47715 15.5228 0 10 0C4.47715 0 0 4.47715 0 10C0 15.5228 4.47715 20 10 20C15.5228 20 20 15.5228 20 10Z" fill="#E9E9E9" />
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M10.997 9.99698L15 14L14.0142 15L10.0001 10.9923L5.98608 15L5.00024 14L9.00327 9.99698L5 6L6 5L10.0001 9.00012L14.0002 5L15.0002 6L10.997 9.99698Z" fill="white" />
                                </g>
                            </g>
                        </svg>
                    </button>
                </div>
