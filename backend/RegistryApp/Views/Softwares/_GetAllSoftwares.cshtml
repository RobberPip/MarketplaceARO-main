                                          stroke="@(Model[i].IsLiked ? "none" : "#000000")" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            }
                                <p id="like-count-@Model[i].Id" class="text2-gray">
                                    @Model[i].LikeCount
