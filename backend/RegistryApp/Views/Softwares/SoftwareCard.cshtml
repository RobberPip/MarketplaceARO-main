@* Toast notification: copy to clipboard *@
<div class="toast-container p-3 position-fixed top-0 start-50 translate-middle-x">
    <div id="copy-shortlink-toast" class="toast notify-toast" role="alert" aria-live="assertive" aria-atomic="true">
        <p id="notify-toast-text" class="text4-white"></p>
        <button class="close-notify-toast" type="button" data-bs-dismiss="toast">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M7.19635 5.99635L12 10.8L10.817 12L6.00012 7.1907L1.18325 12L0.000244141 10.8L4.8039 5.99635L0 1.2L1.2 0L6.00012 4.80012L10.8002 0L12.0002 1.2L7.19635 5.99635Z" fill="#898989" />
            </svg>
        </button>
    </div>
</div>


@section Scripts {
    <script>
        function getVendorCard(input) {
            $.redirect("/vendor/card", {
                el_id: input,
            }, "POST", "_blank");
        }
    </script>
    @* Functions update likes *@
    <script>
        function toggleLike(event, softwareId, element) {
            if (!@Json.Serialize(ViewBag.IsAuthenticated)) {
                return;
            }
            let isLiked = element.getAttribute("fill") === "currentColor";
            let newFill = isLiked ? "none" : "currentColor";
            let newStroke = isLiked ? "#000000" : "none";

            element.setAttribute("fill", newFill);
            let path = element.querySelector("path");
            if (path) {
                path.setAttribute("stroke", newStroke);
            }

            sendLikeRequest(softwareId, !isLiked, element);
        }

        function sendLikeRequest(softwareId, like, element) {
            fetch('/api/v1/like-software', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    "softwareId": softwareId,
                    "like": like
                })
            })
                .then(response => response.json())
                .then(data => {
                    updateLikeCount(softwareId, data.likeCount);
                })
        }

        function updateLikeCount(softwareId, likeCount) {
            let likeText = document.querySelector(`#like-count-${softwareId}`);
            let separator = document.querySelector(`#like-separator-${softwareId}`);
            let vendorName = document.querySelector(`#vendor-name-${softwareId}`);

            if (likeText) {
                likeText.textContent = `${likeCount}`;
            }


            if (vendorName && vendorName.textContent.trim() !== "") {
                separator.style.display = 'inline';
            }
        }

    </script>
    @* Show notification and copy url *@
    <script>
        function showNotificationAndCopyUrl(input) {
            const notification = document.getElementById('copy-shortlink-toast');
            const message = document.getElementById('notify-toast-text');
            message.textContent = "Ссылка скопирована в буфер обмена";
            navigator.clipboard.writeText(input);

            const toastBootstrap = bootstrap.Toast.getOrCreateInstance(notification);
            toastBootstrap.show();
        }
    </script>
}
