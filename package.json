{
	"name": "softwares-market",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:back": "dotnet watch --project backend/App",
		"build:front": "vite build --base=/app",
		"build": "./build.sh",
		"preview": "vite preview",
		"format": "biome format --write ./frontend",
		"lint": "biome check --apply ./frontend",
		"openapi": "pnpm openapi:types",
		"openapi:types": "openapi-typescript http://localhost:5000/swagger/v1/swagger.json -o frontend/shared/api/schema.d.ts && biome format --write frontend/shared/api/schema.d.ts",
		"openapi:zod": "typed-openapi http://localhost:5000/swagger/v1/swagger.json -o frontend/shared/api/zod.ts -r zod && biome format --write frontend/shared/api/zod.ts"
	},
	"dependencies": {
		"@effector/reflect": "9.2.0",
		"@farfetched/atomic-router": "^0.12.8",
		"@farfetched/core": "0.12.8",
		"@farfetched/zod": "^0.12.8",
		"@tanstack/react-form": "^0.41.3",
		"@tanstack/zod-form-adapter": "^0.41.3",
		"atomic-router": "0.10.1",
		"atomic-router-react": "0.10.0",
		"clsx": "^2.1.1",
		"effector": "23.2.3",
		"effector-react": "23.2.1",
		"history": "5.3.0",
		"openapi-fetch": "^0.13.0",
		"openapi-ff": "^0.1.3",
		"patronum": "2.2.0",
		"primeflex": "^3.3.1",
		"primereact": "^10.8.4",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-easy-crop": "5.5.0",
		"zod": "3.24.2"
	},
	"devDependencies": {
		"@babel/core": "7.25.2",
		"@babel/preset-env": "7.25.4",
		"@babel/preset-react": "7.24.7",
		"@babel/preset-typescript": "7.24.7",
		"@biomejs/biome": "^1.9.4",
		"@rollup/plugin-babel": "6.0.4",
		"@tabler/icons": "^3.26.0",
		"@types/node": "22.5.5",
		"@types/react": "18.2.15",
		"@types/react-dom": "18.2.7",
		"@vitejs/plugin-react": "4.2.1",
		"openapi-typescript": "^7.6.1",
		"sass": "^1.80.6",
		"typed-openapi": "^0.10.1",
		"typescript": "5.2.2",
		"vite": "5.3.1"
	}
}
